# Проектные настройки. ПРАВЬТЕ ПЕРЕД ПЕРВЫМ ЗАПУСКОМ.
#
# Формат: KEY=value, без кавычек, без пробелов вокруг `=`. Файл подключается
# в Makefile через `include .env` (читается как make-syntax — `=` это
# валидное make-присваивание). Кавычки в значении станут частью значения,
# поэтому НЕ оборачивайте: `DOMAIN=bes-v.ru` — да, `DOMAIN="bes-v.ru"` — нет.
#
# domain_name должен совпадать с одноимённой переменной в
# inventory/group_vars/all/main.yml (make не умеет читать yaml, поэтому
# дублируем здесь — синхронизировать руками при смене домена).

DOMAIN=bes-v.ru
