worker_processes 1;
user www-data;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 512;
}

http {
    # Настройка error_log для отправки в syslog (journald) (используется в file2ban)
    error_log syslog:server=unix:/dev/log warn;
    # Настройка access_log для отправки в syslog (journald)  (используется в file2ban)
    access_log syslog:server=unix:/dev/log;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    # Размер хэш-таблицы типов (дистрибутив ставит 2048). Без неё на полном
    # mime.types nginx может ругаться "types_hash_max_size too small"
    # (встроенный дефолт всего 1024)
    types_hash_max_size 2048;
    sendfile on;
    # Отправлять HTTP-заголовок и начало файла одним пакетом; работает в паре
    # с sendfile, уменьшает число TCP-пакетов и накладные расходы (TCP_CORK)
    tcp_nopush on;
    client_max_body_size 1m; # Глобально всё ограничим, потом у конкретного server переопределим
    keepalive_timeout 65;
    server_tokens off;  # Скрыть версию Nginx для безопасности

    # Сжатие ответов — экономия трафика и ускорение отдачи текстовых ресурсов
    gzip on;
    # Vary: Accept-Encoding — чтобы прокси/CDN не отдавали gzip-ответ клиенту без поддержки
    gzip_vary on;
    # Не сжимать мелкие ответы: накладные расходы gzip больше выгоды
    gzip_min_length 256;
    # Баланс CPU/степень сжатия. На low-memory сервере уровень 9 не оправдан:
    # прирост сжатия мизерный, а CPU в разы больше
    gzip_comp_level 5;
    # По умолчанию проксированные запросы не сжимаются (off) — включаем для всех
    gzip_proxied any;
    # text/html сжимается всегда и неявно, его в список добавлять не нужно.
    # Уже сжатые форматы (jpg/png/woff2/zip) намеренно НЕ перечислены —
    # повторное сжатие только жжёт CPU без выигрыша.
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/xml
        application/rss+xml
        application/atom+xml
        image/svg+xml;
    #  Нюанс безопасности (BREACH): сжатие HTML по TLS теоретически уязвимо к BREACH (утечка CSRF-токена через размер ответа). Но Yii2 по умолчанию маскирует CSRF-токен (рандомизация на каждый запрос) — это штатная митигация BREACH, так что сжимать HTML безопасно. Просто чтобы ты знал, почему это не проблема в нашем стеке.

    # Безопасные TLS-дефолты на случай ssl-сервера без явных настроек.
    # Теперь это единственное место настроек TLS для всех сайтов: 443-блоки рисует сам шаблон
    # роли (templates/_vhost.j2), certbot конфиг nginx не трогает (certonly --webroot), и его
    # /etc/letsencrypt/options-ssl-nginx.conf не подключается. Именно этот файл, годами не
    # обновлявшийся на старых серверах, оставлял TLS 1.0/1.1 и шифры без Forward Secrecy —
    # устройства Apple обрывали соединение (разбор: /workspace/TODO/Certbot/Certbot.md).
    #
    # Профиль Mozilla «Intermediate» (https://ssl-config.mozilla.org/): TLS 1.2 и 1.3, только
    # шифры с Forward Secrecy (ECDHE) и AEAD. Шифры DHE из профиля не взяты: без ssl_dhparam
    # nginx их всё равно не использует, а свой dhparam ради клиентов без ECDHE не нужен.
    # Шифры TLS 1.3 OpenSSL выбирает сам, ssl_ciphers на них не влияет.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    # off — по профилю Mozilla: все шифры списка стойкие, и клиент выбирает быстрейший для себя
    # (телефоны без AES-ускорителя берут ChaCha20).
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    # Тикеты сессий выключены: ключ тикетов nginx не меняет до перезапуска, и это ослабляет
    # Forward Secrecy. Возобновление сессий работает через кэш выше.
    ssl_session_tickets off;
    # OCSP stapling не включён: Let's Encrypt в 2025 году прекратил OCSP, в новых сертификатах
    # адреса OCSP нет, и директива дала бы только предупреждения.

    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;

}













