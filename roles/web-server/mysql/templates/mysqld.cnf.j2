##########################################################
#
# Пример файла для слабого сервера
# 2GB RAM на все компоненты - Redis, PHP, MySQL, Nginx
#
##########################################################

[mysqld]
#
# Базовые настройки безопасности
#
bind-address = 127.0.0.1 # Прослушивание только localhost
local-infile = 0 # Отключает функцию LOAD DATA LOCAL INFILE, которая позволяет загружать файлы с клиентской машины в базу данных. Это устраняет потенциальный вектор атаки, связанный с чтением файлов злоумышленником.
sql_mode = STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
default_authentication_plugin = mysql_native_password

#
# Логирование запросов, выполняющихся длительное время (только для отладки, используйте journald)
#
slow_query_log = 1
slow_query_log_file = /dev/stderr  # В journald
long_query_time = 2 # Время запроса в секундах, начиная с которого запрос считается медленным
general_log = 0  # Отключено для продакшн (нагружает RAM)

#
# Собирает данные времени выполнения для анализа и улучшения производительности (отключено для экономии памяти)
#
performance_schema = OFF

#
# Отключение устаревших движков
#
disabled_storage_engines = "MyISAM,MEMORY"

#
# InnoDB настройки для 2GB RAM
#
innodb_file_per_table = ON
innodb_buffer_pool_size = 256M  # 10-20% от RAM # # Размер буфера под все нужды, он должен составлять порядка 70-80 % от общей памяти сервера БД (Это если кроме MySQL на сервере больше ничего не крутится)  # Для RAM=2ГБ можно 256-512 МБ (около 20-30% от доступной памяти для MySQL, предполагая, что другие сервисы берут ~1 ГБ, а под MySQL будет выделено ~500-700 МБ). # Для 1GB RAM - 128M ?
innodb_redo_log_capacity = 32M # innodb_log_file_size - заменен на innodb_redo_log_capacity в MySQL 8.0.
innodb_flush_log_at_trx_commit = 2  # Баланс производительности и безопасности
innodb_flush_method = O_DIRECT

#
# Пул соединений
#
max_connections = 80 # Максимальное количество соединений 50-100
thread_cache_size = 8 # Сколько потоков сервер должен кэшировать для повторного использования. # default = -1 (automate)
table_open_cache = 2000
table_definition_cache = 800

#
# Буферы для запросов
#
max_allowed_packet = 16M # default = 64M; # Максимальный возможный размер пакета. Он должен быть такого же размера, как самый большой BLOB-объект, который вы хотите использовать.
tmp_table_size = 2M # Настройки для хранения временных таблиц в памяти. Временные таблицы часто образуются при больших джойнах. (При маленьких объёмах данных неважно)
max_heap_table_size = 4M
sort_buffer_size = 512K # Каждый поток, которому необходимо выполнить сортировку, выделяет буфер такого размера. # default = 256K
read_buffer_size = 256K
read_rnd_buffer_size = 512K

# Кэширование запросов (устарело в MySQL 8.0, удалено)
# query_cache_type = 0

# Бинарный лог (отключен для простоты)
# log_bin = /var/log/mysql/mysql-bin.log
# expire_logs_days = 7

[mysqldump]
# Максимальный возможный размер пакета. Он должен быть такого же размера, как самый большой BLOB-объект, который вы хотите использовать.
max_allowed_packet = 16M # default = 24M

[mysql]
# Клиентские настройки
max_allowed_packet = 16M
