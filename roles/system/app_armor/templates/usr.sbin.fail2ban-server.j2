#include <tunables/global>
/usr/bin/fail2ban-server {
  #include <abstractions/base>
  capability dac_override,
  /var/log/fail2ban.log* rw,
  /var/run/fail2ban/* rw,
  /etc/fail2ban/** r,
  /usr/bin/fail2ban-server ix,
  /var/log/nginx/* r,
  /var/log/mysql/* r,
  /var/log/redis/* r,
  /var/log/auth.log r,
  /usr/sbin/ufw w, # Поскольку fail2ban использует UFW (banaction = ufw), убедитесь, что профиль AppArmor для fail2ban разрешает выполнение команд UFW
}
